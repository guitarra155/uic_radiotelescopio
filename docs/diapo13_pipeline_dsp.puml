@startuml diapo13_pipeline_dsp

left to right direction
skinparam BackgroundColor #FFFFFF
skinparam DefaultFontSize 13
skinparam DefaultFontColor #2D3748
skinparam BorderColor #4A5568
skinparam linetype ortho

rectangle "Muestras I/Q Crudas" as IQ #FAFAFA

package "Preprocesamiento Temporal" as PRE #E8F5E9 {
    rectangle "Filtro Promedio Móvil\n(Moving Average / Opcional)" as MA #C8E6C9
    rectangle "Ventaneo Temporal\n(Hanning / Hamming)" as WINDOW #C8E6C9
}

package "Algoritmos de Estimación Espectral" as ESTIM #E3F2FD {
    rectangle "FFT Clásica\n(Resolución Básica)" as FFT #BBDEFB
    rectangle "Welch PSD\n(Promediado de bloques)" as WELCH #BBDEFB
    rectangle "Modelo Autorregresivo\n(Algoritmo de Burg)" as BURG #BBDEFB
    rectangle "Correlograma\n(FFT de Autocorrelación)" as CORR #BBDEFB
}

rectangle "Espectro de Potencia (PSD)\n(Estimación Espectral)" as PSD #BBDEFB
rectangle "Suavizado Espectral\n(Filtro IIR / VBW Smoothing)" as SMOOTH #C8E6C9
rectangle "Visualización & Cascada\n(Matplotlib GUI)" as VIS #FFF9C4

IQ --> MA : (Si MA habilitado)
IQ --> WINDOW : (Bypass / MA inactivo)
MA --> WINDOW : Señal filtrada
WINDOW --> FFT
WINDOW --> WELCH
WINDOW --> BURG
WINDOW --> CORR
FFT --> PSD
WELCH --> PSD
BURG --> PSD
CORR --> PSD
PSD --> SMOOTH : Reducción de varianza
SMOOTH --> VIS : Renderizado

@enduml
