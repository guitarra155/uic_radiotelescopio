@startuml diapo10_estructura_software

left to right direction
skinparam BackgroundColor #FFFFFF
skinparam DefaultFontSize 13
skinparam DefaultFontColor #2D3748
skinparam BorderColor #4A5568
skinparam linetype ortho

package "Raíz del Proyecto" as Root #ECEFF1 {
    rectangle "main.py\n(Inicializador de GUI)" as MAIN #FEE2E2
    
    package "core/\n(Motor & Lógica)" as Core #E3F2FD {
        rectangle "dsp_engine.py\n(Singleton / Hilos)" as ENG #BBDEFB
        rectangle "advanced_dsp.py\n(Estimadores & Filtros)" as ADV #BBDEFB
        rectangle "bbdevice/\n(Wrapper C++ API)" as API #BBDEFB
    }
    
    package "ui/\n(Vistas & Gráficas)" as UI #E8F5E9 {
        rectangle "tabs/\n(Pestañas del Sistema)" as TABS #C8E6C9
        rectangle "charts/\n(Renderizadores Matplotlib)" as CHARTS #C8E6C9
    }
}

MAIN --> ENG : Controla Adquisición
ENG --> ADV : Invoca Algoritmos
ENG --> API : Controla Hardware
TABS --> ENG : Consulta Datos
TABS --> CHARTS : Solicita Gráficas

@enduml
