@startuml diapo12_secuencia_bb60c

skinparam BackgroundColor #FFFFFF
skinparam DefaultFontSize 13
skinparam DefaultFontColor #2D3748
skinparam BoxPadding 15

participant "Motor DSP\n(dsp_engine.py)" as ENG #BBDEFB
participant "Wrapper API\n(bb_api.py)" as API #C8E6C9
participant "Hardware SDR\n(BB60C)" as HW #FAFAFA

== Ciclo de Inicialización y Stream ==

ENG -> API : bb_open_device()
API -> HW : Inicializa hardware USB 3.0
ENG -> API : bb_configure_gain(), bb_configure_IQ_center()
ENG -> API : bb_initiate(BB_STREAMING)
API -> HW : Configura modo streaming continuo

loop Adquisición de Muestras (Hilo de Fondo)
    ENG -> API : bb_get_IQ_unpacked()
    API -> HW : Solicita muestras digitalizadas
    HW --> ENG : Datos I/Q en punto flotante
end

@enduml
