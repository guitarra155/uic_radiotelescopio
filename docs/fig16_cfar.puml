@startuml fig16_cfar

' Configuración A4
skinparam BackgroundColor #FFFFFF
skinparam DefaultFontSize 12
skinparam DefaultFontColor #2D3748
skinparam TitleFontSize 16
skinparam ActivityBackgroundColor #F0F4F8
skinparam ActivityBorderColor #4A5568
skinparam ArrowColor #4A5568

title Algoritmo de Detección CFAR — Detección de Señales de Interés

start

#D6EAF8:Recibir espectro RAW\n**spectrum_raw_data[k]**\n(N_FFT bins en dBFS);

#D6EAF8:Calcular tamaño del kernel\nk_size = max(3, N_FFT × 0.04)\n(Asegurar impar);

#AED6F1:Aplicar **Filtro de Mediana**\ndeslizante al espectro\nnoise_floor[k] = medfilt(\nspectrum_raw_data, k_size);

note right
    El filtro de mediana estima
    el piso de ruido localmente
    sin verse afectado por
    los picos espectrales
end note

#D5F5E3:Calcular **SNR por bin**\nSNR[k] = P_señal[k] − P_ruido[k]\n(Resta en dBFS);

#ABEBC6:Aplicar **Umbral de Detección**\nSNR_THRESH = 6 dB;

if (¿Existen bins con\nSNR[k] > 6 dB?) then (Sí)
    #FCF3CF:Obtener frecuencias\ny SNR de los bins\nque superan el umbral;
    
    #FCF3CF:Ordenar por frecuencia\nascendente;
    
    #E8DAEF:Aplicar **Clustering**\n(Agrupamiento)\nSeparación mínima: 10 kHz;
    
    note right
        Dentro de cada cluster,
        se selecciona el bin
        con mayor SNR como
        representante
    end note
    
    #D2B4DE:Generar lista de\n**Señales de Interés**\n[(freq_MHz, SNR_dB), ...]\nMáximo: 20 detecciones;
    
else (No)
    #FADBD8:signals_of_interest = []\n(Sin detecciones);
endif

#F5B7B1:Verificar **RFI**\n¿SNR > 15 dB?;

if (¿rfi_mitigation_on\ny SNR > 15 dB?) then (Sí)
    #F5B7B1:Incrementar\nrfi_event_count\nRegistrar hora UTC;
else (No)
    :Sin acción RFI;
endif

stop

@enduml
