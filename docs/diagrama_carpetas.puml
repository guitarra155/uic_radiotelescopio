@startwbs Estructura_Directorios_Tesis_WBS_Final

' Configuración de apariencia pastel limpia y legible para tesis A4
skinparam BackgroundColor #ffffff
skinparam Shadowing false
skinparam wbs {
    LineColor #7f8c8d
    LineWidth 1.2
    FontName "Segoe UI"
    FontColor #2D3748 ' Texto oscuro para que resalte sobre los pasteles
}

' La notación de signos más (+) en WBS dibuja un árbol plano de izquierda a derecha (estilo explorador)
' Garantiza matemáticamente que ninguna línea se cruce y mantiene un orden perfecto.
+ uic_radiotelescopio/ #[#E2E8F0]
++ main.py\n(Punto de entrada y controlador principal de la GUI Flet) #[#FFD1DC]
++ core/ (Capa de control, procesamiento digital y drivers) #[#D1E9F6]
+++ dsp_engine.py\n(Motor de procesamiento Singleton y gestión de hilos) #[#F1D4E5]
+++ advanced_dsp.py\n(Algoritmos de estimación espectral clásicos y paramétricos) #[#F1D4E5]
+++ algo_registry.py\n(Registro y mapeo dinámico de funciones matemáticas) #[#F1D4E5]
+++ constants.py\n(Constantes físicas, del sistema y estilos visuales globales) #[#F1D4E5]
+++ bbdevice/ (Abstracción de bajo nivel del hardware SDR) #[#E8F5E9]
++++ bb_api.py\n(Wrapper ctypes para llamadas C++ en Python) #[#FFE0B2]
++++ bb_api.dll\n(Biblioteca dinámica provista por el fabricante) #[#FFE0B2]
++ ui/ (Capa de presentación - Entorno gráfico de usuario) #[#F6E9B2]
+++ tabs/ (Módulos que orquestan las vistas e inputs de cada pestaña) #[#E8F5E9]
++++ estado.py\n(Pestaña 1: Configuración de hardware y manuales) #[#FFE0B2]
++++ dual_monitoring.py\n(Pestaña 2: Monitoreo en tiempo/frecuencia) #[#FFE0B2]
++++ spectrogram.py\n(Pestaña 3: Espectrogramas) #[#FFE0B2]
++++ statistics.py\n(Pestaña 4: Histogramas y estimación) #[#FFE0B2]
++++ signal_analysis.py\n(Pestaña 5: Series temporales de potencia) #[#FFE0B2]
++++ freq_snr.py\n(Pestaña 6: Gráficas de relación señal-ruido) #[#FFE0B2]
++++ sdr_config.py\n(Panel lateral de control dinámico y auto-escala) #[#FFE0B2]
+++ charts/ (Renderizadores gráficos autónomos basados en Matplotlib) #[#E2F0D9]
++++ monitoring.py\n(Gráficas de monitoreo temporal/frecuencial 2x2) #[#FFD1DC]
++++ spectrogram.py\n(Renderizado de cascadas de potencia espectral en 2D) #[#FFD1DC]
++++ statistics.py\n(Renderizado de histogramas con curvas teóricas) #[#FFD1DC]
++++ signal_analysis.py\n(Renderizado de series temporales de potencia) #[#FFD1DC]
++++ freq_snr.py\n(Renderizado de picos de relación señal-ruido) #[#FFD1DC]
+++ components/ (Elementos comunes e instrumentación del layout) #[#D1E9F6]
++++ layout.py\n(Barra de cabecera superior y pie de página de la aplicación) #[#F1D4E5]
++++ shared.py\n(Widgets genéricos, campos de texto y estilos comunes) #[#F1D4E5]
++ data/ (Directorio local para almacenamiento de archivos binarios .iq) #[#FFD1DC]
++ docs/ (Documentación de diseño del sistema) #[#F1D4E5]

@endwbs
