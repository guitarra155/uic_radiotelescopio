@startuml Figura11_Flujo_Datos

' Configuración para formato A4 vertical con distribución horizontal optimizada
skinparam linetype ortho
skinparam BackgroundColor #FFFFFF
skinparam ArrowColor #4A5568
skinparam DefaultFontColor #2D3748
skinparam DefaultFontSize 13
skinparam TitleFontSize 16
skinparam BoxPadding 15

' Estilos de Cajas en Tonos Pastel
skinparam rectangle {
    BackgroundColor #F7FAFC
    BorderColor #CBD5E0
    FontColor #1A202C
}

header Plataforma UIC Radiotelescopio
title Flujo de Datos y Control General

' Definición de Bloques
rectangle "1. Capa de Adquisición" as CapaAdq #F0FDF4 {
    rectangle "Hardware SDR\n(BB60C)" as SDR #DCFCE7
    rectangle "Lector de Archivos\n(Muestras I/Q *.npy)" as Files #DCFCE7
    rectangle "API / Abstracción\n(bb_api.py / Wrapper C++)" as API #DCFCE7
}

rectangle "2. Capa de Procesamiento (DSP Engine)" as CapaDSP #EBF8FF {
    rectangle "Filtrado Digital\ny Decimación (DSP)" as Filter #DBEAFE
    rectangle "Estimación Espectral\n(Welch / Burg)" as PSD #DBEAFE
    rectangle "Algoritmo de Detección\ny Umbralización (CFAR)" as Detec #DBEAFE
}

rectangle "3. Capa de Presentación (Flet UI)" as CapaUI #FDF2F2 {
    rectangle "Gestión de Eventos\ny Pestañas (main.py)" as Eventos #FEE2E2
    rectangle "Gráficos Multidominio\n(Matplotlib / Flet)" as Charts #FEE2E2
    rectangle "Panel de Ajustes\n(sdr_config.py)" as Config #FEE2E2
}

rectangle "4. Persistencia" as CapaPers #FFFDF5 {
    database "Archivo Config\n(config.json)" as JSON #FEF3C7
}

' Flujo de Datos (Líneas rectas y ordenadas)
SDR -down-> API : Flujo I/Q Continuo
Files -down-> Filter : Muestras de prueba
API -down-> Filter : Muestras de alta tasa

Filter -right-> PSD : Muestras Diezmadas
PSD -right-> Detec : Espectro Estimado

Detec -down-> Eventos : Notificaciones (PubSub)
Detec -down-> Charts : Datos de Potencia y Histograma

Eventos -right-> Config : Sincroniza Parámetros
Config -up-> JSON : Carga / Guarda
JSON -left-> Filter : Carga Filtros

@enduml
