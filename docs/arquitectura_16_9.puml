@startuml arquitectura_16_9

' Configuración para disposición clásica (de arriba a abajo)
skinparam linetype ortho
skinparam BackgroundColor #FFFFFF
skinparam DefaultFontSize 13
skinparam DefaultFontColor #2D3748
skinparam ArrowColor #4A5568
skinparam BoxPadding 25

skinparam package {
    BackgroundColor #FAFAFA
    BorderColor #4A5568
    FontColor #1A202C
    FontSize 14
}

skinparam rectangle {
    RoundCorner 6
    BorderColor #718096
    FontColor #2D3748
    FontSize 12
}

package "1. Capa de Adquisición" as LayerHW #E8F5E9 {
    rectangle "Hardware BB60C\n(Wrapper API C++)" as BBAPI #C8E6C9
    rectangle "Lector de Datos\n(Archivos I/Q Locales)" as SIM #C8E6C9
}

package "2. Capa de Procesamiento (DSP)" as LayerCore #E3F2FD {
    rectangle "Hilos de Adquisición\ny Buffers Circulares" as ENGINE #BBDEFB
    rectangle "Módulos DSP\n(FFT, Welch, CWT, Burg)" as ADV #BBDEFB
    
    ENGINE <-down-> ADV : Estimación Espectral
}

package "3. Capa de Presentación (GUI)" as LayerUI #FFEBEE {
    rectangle "Controlador Principal\n(Flet / main.py)" as MAIN #FFCDD2
    rectangle "Paneles Científicos\n(Espectro, Histograma, Cascada)" as VISTAS #FFCDD2
    
    MAIN -down-> VISTAS : Renderizado
}

' Conexiones de flujo horizontal entre capas
BBAPI --> ENGINE : Muestras I/Q
SIM --> ENGINE : Datos I/Q
ENGINE <-down-> VISTAS : Lectura de Espectro / Zoom

' Restricciones de apilamiento vertical
LayerHW -[hidden]down-> LayerUI
LayerCore -[hidden]down-> LayerUI

@enduml
