@startuml Esquema_Proyecto_Radiotelescopio

' Optimización Estricta de Líneas Ortogonales sin Cruces Caóticos para Word
skinparam linetype ortho
skinparam BackgroundColor #FFFFFF
skinparam ArrowColor #4A5568
skinparam BoxPadding 15
skinparam ranksep 35
skinparam nodesep 25

' Aumento de tamaño de letra para máxima legibilidad
skinparam DefaultFontColor #2D3748
skinparam DefaultFontSize 14
skinparam TitleFontSize 18
skinparam HeaderFontSize 12

skinparam rectangle {
    BackgroundColor #F7FAFC
    BorderColor #E2E8F0
    FontColor #1A202C
    FontSize 15
}

skinparam database {
    BackgroundColor #EDF2F7
    BorderColor #CBD5E0
    FontColor #2D3748
    FontSize 14
}

skinparam component {
    BackgroundColor #EDF2F7
    BorderColor #CBD5E0
    FontColor #2D3748
    FontSize 14
}

header Plataforma DSP Radiotelescopio (UIC)
title Arquitectura General y Flujo de Datos (Formato Vertical)

' --- CAPA PRESENTACIÓN (Arriba - Rojo/Rosa Pastel) ---
rectangle "Capa de Presentación (Flet UI)" as LayerUI #FDF2F2 {
    component "main.py\n(Ciclo Principal Flet)" as Main #FDE8E8
    component "ui/tabs/\n(Pestañas de Análisis)" as Tabs #FDE8E8
    component "ui/components/\n(Controles e Inputs)" as Components #FDE8E8
    component "ui/charts/\n(Paquete de Gráficas)" as Charts #FDE8E8
    
    ' Disposición interna ordenada
    Main -down-> Tabs : Construye
    Tabs -right-> Components : Diseña
    Tabs -left-> Charts : Renderiza
}

' --- CAPA CONTROL & PROCESAMIENTO (Centro - Azul Pastel) ---
rectangle "Capa de Control y Procesamiento (Core)" as LayerCore #EBF8FF {
    component "core/dsp_engine.py\n(DSPEngine - Singleton)" as Engine #EBF8FF
    component "core/advanced_dsp.py\n(Algoritmos)" as AdvDSP #EBF8FF
    component "core/algo_registry.py\n(Registro Único)" as Registry #EBF8FF
    component "core/constants.py\n(Tema/Colores)" as Constants #EBF8FF
    
    ' Disposición interna limpia
    Engine -down-> AdvDSP : Ejecuta
    AdvDSP -down-> Registry : Mapea
    Engine -right-> Constants : Tema
}

' --- CAPA ADQUISICIÓN & HARDWARE (Abajo - Verde Pastel) ---
rectangle "Capa de Adquisición y Hardware" as LayerHW #F0FDF4 {
    database "data/ (*.iq)\n(Archivos Grabados)" as IQFiles #DCFCE7
    component "core/bbdevice/bb_api.py\n(Wrapper ctypes)" as BBApi #DCFCE7
    file "core/bbdevice/bb_api.dll\n(Librería C++ Nativa)" as BBDll #DCFCE7
    entity "SDR BB60C\n(Hardware)" as SDR #DCFCE7
    
    ' Disposición vertical interna
    IQFiles -down-> BBApi : Carga
    BBApi -down-> BBDll : ctypes
    BBDll -right-> SDR : USB 3.0
}

' Salida de datos abajo para evitar cruces laterales con la UI
database "Resultados_Datos/\n(Capturas, Eventos)" as Output #E2E8F0

' --- RELACIONES INTER-CAPAS (Flujo puramente vertical de arriba a abajo) ---

' 1. Interfaz de Usuario con el Motor Core
Main -down-> Engine : Inicia / Controla hilos
Engine -up-> Main : Notifica "data_ready" (PubSub)
Components -down-> Engine : Envía sintonización (Live Tuning)
Tabs -down-> Engine : Consulta estado

' 2. Adquisición de Datos del Motor con la Capa de Hardware
Engine -down-> IQFiles : Hilo _process_file_loop()
Engine -down-> BBApi : Hilo _process_sdr_loop()

' 3. Salida de Datos hacia la Base de Datos (Flujo descendente directo)
Charts -down-> Output : Guarda imágenes (PNG/SVG)
Engine -down-> Output : Guarda Smart Trigger (.npy)

' Forzar el apilamiento vertical estricto de las capas
LayerUI -down-> LayerCore
LayerCore -down-> LayerHW
LayerHW -down-> Output

@enduml
