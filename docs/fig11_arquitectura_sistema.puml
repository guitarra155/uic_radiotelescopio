@startuml fig11_arquitectura_sistema

' Optimización estricta para disposición vertical y líneas ortogonales rectas
skinparam linetype ortho
skinparam BackgroundColor #FFFFFF
skinparam DefaultFontSize 12
skinparam DefaultFontColor #2D3748
skinparam TitleFontSize 15
skinparam ArrowColor #4A5568
skinparam BoxPadding 15

skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #2D3748
    FontColor #2D3748
}

skinparam rectangle {
    RoundCorner 4
    BorderColor #718096
    FontColor #2D3748
    FontSize 11
}

title Arquitectura General y Capas del Sistema (Figura 11)

package "Capa de Presentación (GUI)" as LayerUI #FFF5F5 {
    rectangle "sdr_config.py\n(Sincronización)" as CONFIG #FEE2E2
    rectangle "main.py\n(Controlador Flet)" as MAIN #FEE2E2
    rectangle "Vistas (Tabs)\n(dual_monitoring.py,\nmonitoring.py, etc.)" as VISTAS #FEE2E2
    
    ' Disposición de la GUI
    CONFIG -down-> MAIN : Sincroniza interfaz
    MAIN -down-> VISTAS : Instancia y Muestra
}

package "Capa de Procesamiento (DSP Core)" as LayerCore #F0F8FF {
    rectangle "dsp_engine.py\n(DSPEngine - Hilos DSP)" as ENGINE #E6F2FF
    rectangle "advanced_dsp.py\n(Algoritmos Físicos)" as ADV #E6F2FF
    
    ' Disposición vertical interna del Core
    ENGINE <-down-> ADV : Invoca / Retorna espectro
}

package "Capa de Adquisición" as LayerHW #F5FFF5 {
    ' Dejar estos dos componentes lado a lado para que la capa de adquisición
    ' se alinee perfectamente abajo de la capa Core sin desplazarse a la derecha.
    rectangle "bb_api.py\n(Wrapper ctypes)" as BBAPI #E6FFE6
    rectangle "Simulador Sintético\n(Señales Ficticias)" as SIM #E6FFE6
}

' Relaciones entre capas forzando dirección vertical descendente
VISTAS <-down-> ENGINE : Lee espectro / Envía comandos y zoom
ENGINE <-down-> BBAPI : Controla SDR / Recibe muestras I/Q
ENGINE <-down-> SIM : Controla reproducción / Recibe muestras

' Forzar el apilamiento vertical absoluto de las capas
LayerUI -[hidden]down-> LayerCore
LayerCore -[hidden]down-> LayerHW

@enduml
