@startuml diapo16_lectura_iq

left to right direction
skinparam BackgroundColor #FFFFFF
skinparam DefaultFontSize 13
skinparam DefaultFontColor #2D3748
skinparam BorderColor #4A5568
skinparam linetype ortho

database "Almacenamiento Local\n(Archivos IQ .bin/.wav)" as DISCO #ECEFF1
rectangle "Parser Binario\n(Decodificación float32/int16)" as PARSER #C8E6C9
rectangle "Conversión de Formato\n(Datos Complejos I + jQ)" as FORMAT #C8E6C9
rectangle "Buffer Circular en RAM\n(dsp_engine.py)" as RAM #BBDEFB
rectangle "Pipeline DSP\n(FFT & Estimadores)" as Pipeline #FFCDD2

DISCO --> PARSER : Lectura por bloques
PARSER --> FORMAT : Agrupamiento de muestras
FORMAT --> RAM : Carga cíclica (Overlap)
RAM --> Pipeline : Despacho para análisis

@enduml
